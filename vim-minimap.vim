" Automatically start the minimap when opening a file
let g:minimap_auto_start = 1

" Set the width of the minimap window (default is 10)
let g:minimap_width = 10

" Highlight search results inside the minimap
let g:minimap_highlight_search = 1

" Integrate Git diff colors (shows added/modified/removed lines)
let g:minimap_git_colors = 1

" Retain the minimap layout even if close the main buffer
let g:minimap_keep_winnr = 1

" Automatically refresh the minimap when you switch or save files
let g:minimap_auto_start_win_enter = 1

" Adjust how many code characters map to 1 minimap character horizontally (default: 8)
let g:minimap_horizontal_scale = 4

" Adjust how many code lines map to 1 minimap line vertically (default: 4)
let g:minimap_vertical_scale = 2
